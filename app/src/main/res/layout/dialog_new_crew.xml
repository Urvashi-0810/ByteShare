<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_chunky"
    android:backgroundTint="@color/bg_cream"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Handle indicator bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#D1D1D6" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:text="New crew"
        android:textColor="@color/primary_ink"
        android:textSize="28sp" />

    <!-- CREW NAME -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-black"
        android:text="CREW NAME"
        android:textColor="@color/gray_ink"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/edit_crew_name"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/card_chunky"
        android:backgroundTint="@color/muted_cream"
        android:hint="Friday Night"
        android:inputType="textCapWords"
        android:paddingHorizontal="16dp"
        android:textColor="@color/primary_ink"
        android:textColorHint="#9918181F"
        android:textSize="16sp" />

    <!-- VIBE -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-black"
        android:text="VIBE"
        android:textColor="@color/gray_ink"
        android:textSize="12sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/vibe_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/button_chunky"
                android:backgroundTint="@color/muted_cream"
                android:gravity="center"
                android:text="🍕"
                android:textSize="20sp" />

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/button_chunky"
                android:backgroundTint="@color/muted_cream"
                android:gravity="center"
                android:text="🍣"
                android:textSize="20sp" />

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/button_chunky"
                android:backgroundTint="@color/muted_cream"
                android:gravity="center"
                android:text="🌮"
                android:textSize="20sp" />

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/button_chunky"
                android:backgroundTint="@color/muted_cream"
                android:gravity="center"
                android:text="🍜"
                android:textSize="20sp" />

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/button_chunky"
                android:backgroundTint="@color/muted_cream"
                android:gravity="center"
                android:text="🍔"
                android:textSize="20sp" />

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/button_chunky"
                android:backgroundTint="@color/muted_cream"
                android:gravity="center"
                android:text="☕"
                android:textSize="20sp" />

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/button_chunky"
                android:backgroundTint="@color/accent_lime"
                android:gravity="center"
                android:text="🍺"
                android:textSize="20sp" />

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/button_chunky"
                android:backgroundTint="@color/muted_cream"
                android:gravity="center"
                android:text="🍲"
                android:textSize="20sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- BILL (₹) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-black"
        android:text="BILL (₹)"
        android:textColor="@color/gray_ink"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/edit_crew_bill"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/card_chunky"
        android:backgroundTint="@color/muted_cream"
        android:hint="2000"
        android:inputType="numberDecimal"
        android:paddingHorizontal="16dp"
        android:text="2000"
        android:textColor="@color/primary_ink"
        android:textColorHint="#9918181F"
        android:textSize="16sp" />

    <!-- ADD FRIENDS DIRECTLY -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-black"
        android:text="ADD FRIENDS DIRECTLY"
        android:textColor="@color/gray_ink"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/friends_selection_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chip_rahul"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/button_chunky"
            android:backgroundTint="@color/accent_lime"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="🐼 Rahul ✓"
            android:textColor="@color/primary_ink"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chip_priya"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/button_chunky"
            android:backgroundTint="@color/accent_lime"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="🦄 Priya ✓"
            android:textColor="@color/primary_ink"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chip_arjun"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_chunky"
            android:backgroundTint="@color/muted_cream"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="🐯 Arjun + "
            android:textColor="@color/primary_ink"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- CREATE CREW BUTTON -->
    <Button
        android:id="@+id/btn_create_crew_submit"
        style="@style/ByteShareButton"
        android:layout_marginTop="28dp"
        android:background="@drawable/button_chunky"
        android:backgroundTint="@color/primary_ink"
        android:text="Create crew"
        android:textColor="@color/accent_lime" />

</LinearLayout>