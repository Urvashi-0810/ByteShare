<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/ByteShareTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Social Rank" />

            <TextView
                style="@style/ByteShareSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Battle your friends for the lowest time" />

            <!-- Your Usage Card -->
            <LinearLayout
                style="@style/ByteShareCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="0dp"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Your usage"
                    android:textColor="@color/primary_ink"
                    android:textSize="20sp" />

                <LinearLayout
                    android:id="@+id/usage_progress_container"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/button_chunky"
                    android:backgroundTint="#EEEEEE"
                    android:orientation="horizontal"
                    android:clipChildren="true"
                    android:clipToPadding="true">

                    <View
                        android:id="@+id/progress_social"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0"
                        android:background="@color/cat_social" />
                    <View
                        android:id="@+id/progress_stream"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0"
                        android:background="@color/cat_stream" />
                    <View
                        android:id="@+id/progress_neutral"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0"
                        android:background="@color/cat_neutral" />
                    <View
                        android:id="@+id/progress_productive"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0"
                        android:background="@color/cat_productive" />
                </LinearLayout>

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:columnCount="2">

                    <!-- Social -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/card_chunky"
                        android:backgroundTint="@color/bg_cream"
                        android:orientation="vertical"
                        android:padding="10dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SOCIAL"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_ink" />
                        <TextView
                            android:id="@+id/txt_social_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="0m"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Stream -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:background="@drawable/card_chunky"
                        android:backgroundTint="@color/bg_cream"
                        android:orientation="vertical"
                        android:padding="10dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="STREAM"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textColor="@color/gray_ink" />
                        <TextView
                            android:id="@+id/txt_stream_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="0m"
                            android:textSize="14sp" />
                    </LinearLayout>
                </GridLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:fontFamily="sans-serif-black"
                android:text="ELITE LEADERBOARD"
                android:textColor="@color/gray_ink"
                android:textSize="12sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>