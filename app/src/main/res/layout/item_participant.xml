<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/ByteShareCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="0dp"
    android:layout_marginBottom="8dp"
    android:padding="12dp">

    <FrameLayout
        android:id="@+id/participant_avatar_frame"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:background="@drawable/button_chunky"
        android:backgroundTint="@color/white">

        <TextView
            android:id="@+id/txt_participant_avatar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🐯"
            android:textSize="20sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_toEndOf="@id/participant_avatar_frame"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_participant_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="Arjun"
            android:textColor="@color/primary_ink"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txt_participant_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Used Instagram (4m)"
            android:textColor="@color/gray_ink"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Status Badge -->
    <TextView
        android:id="@+id/badge_participant_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:background="@drawable/button_chunky"
        android:backgroundTint="#FFEBEE"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="FAIL"
        android:textColor="#D32F2F"
        android:textSize="10sp"
        android:textStyle="bold" />

</RelativeLayout>