<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:orientation="vertical">

                    <TextView
                        style="@style/ByteShareTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Friends" />

                    <TextView
                        style="@style/ByteShareSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Track your crew members" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btn_invite_friend"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/button_chunky"
                    android:contentDescription="Invite a friend"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_input_add"
                    app:tint="@color/primary_ink" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/card_chunky"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="8dp"
                    android:alpha="0.4"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="@color/primary_ink" />

                <EditText
                    android:id="@+id/edit_search_friends"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@android:color/transparent"
                    android:hint="Search friends..."
                    android:inputType="text"
                    android:textColor="@color/primary_ink"
                    android:textColorHint="@color/gray_ink"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginStart="4dp"
                android:fontFamily="sans-serif-black"
                android:text="ELITE LEADERBOARD"
                android:textColor="@color/gray_ink"
                android:textSize="12sp" />

            <!-- Leaderboard Info Card -->
            <RelativeLayout
                android:id="@+id/leaderboard_info_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/card_chunky"
                android:backgroundTint="#EBFBCC"
                android:padding="12dp">
                
                <TextView
                    android:id="@+id/icon_bulb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡"
                    android:textSize="20sp" />
                    
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/icon_bulb"
                    android:layout_toStartOf="@id/btn_close_info"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="8dp"
                    android:text="Ranks are based on the large black Weighted Score (which penalizes doomscrolling). The small gray number is your raw screen time."
                    android:textColor="@color/primary_ink"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/btn_close_info"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="@color/primary_ink" />
            </RelativeLayout>

            <!-- Contacts permission pitch (hidden once granted) -->
            <LinearLayout
                android:id="@+id/contacts_permission_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_chunky"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="FIND YOUR PEOPLE"
                    android:textColor="@color/primary_ink"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Allow contact access to discover which of your friends are already on ByteShare."
                    android:textColor="@color/gray_ink"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn_allow_contacts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/button_chunky"
                    android:backgroundTint="@null"
                    android:paddingVertical="12dp"
                    android:text="Allow Contacts"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_ink"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/nudge_inbox_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_chunky"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="NUDGES FOR YOU"
                    android:textColor="@color/primary_ink"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/nudge_inbox_messages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/leaderboard_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <!-- Empty state -->
            <TextView
                android:id="@+id/txt_leaderboard_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_chunky"
                android:gravity="center"
                android:padding="24dp"
                android:text="No friends yet. Invite someone or join a crew!"
                android:textColor="@color/gray_ink"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- AdMob Native Ad Container -->
            <FrameLayout
                android:id="@+id/native_ad_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>