<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_chunky"
    android:backgroundTint="@color/bg_cream"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#D1D1D6" />

    <!-- Stripe Card Icon Frame -->
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/button_chunky"
        android:backgroundTint="@color/accent_lime">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="Card payment"
            android:src="@drawable/ic_payment_card" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-black"
        android:text="Settle Bill Share"
        android:textColor="@color/primary_ink"
        android:textSize="26sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:text="Powered by Stripe Secure Checkout"
        android:textColor="@color/gray_ink"
        android:textSize="14sp" />

    <!-- Summary Card -->
    <LinearLayout
        style="@style/ByteShareCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="0dp"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        android:padding="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txt_stripe_crew_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/primary_ink"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/txt_stripe_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/primary_ink"
                android:textSize="22sp" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="#E5E5EA" />

        <TextView
            android:id="@+id/txt_stripe_multiplier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calculated from your seven-day rank"
            android:textColor="@color/gray_ink"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Pay Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_pay_stripe_submit"
        style="@style/ByteShareButton"
        android:layout_marginTop="20dp"
        android:background="@drawable/button_chunky_ink"
        android:backgroundTint="@null"
        android:text="Pay via Stripe 💳"
        android:textColor="@color/accent_lime"
        android:textSize="15sp"
        android:textStyle="bold"
        app:icon="@drawable/ic_payment_card"
        app:iconGravity="textStart"
        app:iconPadding="10dp"
        app:iconTint="@color/accent_lime" />

    <!-- Disclaimer -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="🔒 256-bit SSL Encrypted by Stripe"
        android:textColor="@color/gray_ink"
        android:textSize="12sp" />

</LinearLayout>