<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_chunky"
    android:backgroundTint="@color/bg_cream"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Handle Bar & Close Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_centerInParent="true"
            android:background="#D1D1D6" />

        <ImageView
            android:id="@+id/btn_close_profile"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/button_chunky"
            android:backgroundTint="@color/white"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/primary_ink" />
    </RelativeLayout>

    <!-- Avatar Frame -->
    <FrameLayout
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/button_chunky"
        android:backgroundTint="@color/accent_lime">

        <TextView
            android:id="@+id/txt_profile_avatar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            tools:text="🐼"
            android:textSize="40sp" />
    </FrameLayout>

    <!-- Name & Email -->
    <TextView
        android:id="@+id/txt_profile_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-black"
        tools:text="Friend name"
        android:textColor="@color/primary_ink"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/txt_profile_email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        tools:text="friend@example.com"
        android:textColor="@color/gray_ink"
        android:textSize="12sp" />

    <!-- Streak Badge -->
    <TextView
        android:id="@+id/badge_profile_streak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/button_chunky"
        android:backgroundTint="#FF8A65"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:visibility="gone"
        tools:text="🔥 5 Day Streak"
        tools:visibility="visible"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold" />


    <!-- Daily Stats Cards Row (AVG DAILY & WEIGHTED SCORE) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <!-- AVG DAILY -->
        <LinearLayout
            style="@style/ByteShareCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_marginHorizontal="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="RAW TIME"
                android:textColor="@color/gray_ink"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txt_profile_avg_daily"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-black"
                tools:text="38m"
                android:textColor="@color/primary_ink"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- WEIGHTED SCORE (7 days) -->
        <LinearLayout
            style="@style/ByteShareCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginHorizontal="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="WEIGHTED SCORE"
                android:textColor="@color/gray_ink"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txt_profile_weighted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-black"
                tools:text="412m"
                android:textColor="#F24E1E"
                android:textSize="22sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- DIGITAL FOOTPRINT CARD -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginTop="20dp"
        android:fontFamily="sans-serif-black"
        android:text="DIGITAL FOOTPRINT"
        android:textColor="@color/gray_ink"
        android:textSize="11sp" />

    <!-- Top Category Card -->
    <RelativeLayout
        style="@style/ByteShareCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="0dp"
        android:layout_marginTop="8dp"
        android:padding="14dp">

        <FrameLayout
            android:id="@+id/app_icon_frame"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/button_chunky"
            android:backgroundTint="@color/accent_lime">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="📱"
                android:textSize="20sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/app_icon_frame"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="TOP CATEGORY"
                android:textColor="@color/gray_ink"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/txt_profile_top_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                tools:text="Social"
                android:textColor="@color/primary_ink"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_profile_top_category_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif-black"
            tools:text="79m"
            android:textColor="@color/primary_ink"
            android:textSize="16sp" />
    </RelativeLayout>

    <!-- Weekly Total Card -->
    <RelativeLayout
        style="@style/ByteShareCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="0dp"
        android:layout_marginTop="8dp"
        android:padding="14dp">

        <FrameLayout
            android:id="@+id/weekly_icon_frame"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/button_chunky"
            android:backgroundTint="@color/white">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="📅"
                android:textSize="20sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_toEndOf="@id/weekly_icon_frame"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="TOTAL TIME"
                android:textColor="@color/gray_ink"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Today"
                android:textColor="@color/primary_ink"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_profile_weekly_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif-black"
            tools:text="263m"
            android:textColor="#F24E1E"
            android:textSize="16sp" />
    </RelativeLayout>

</LinearLayout>