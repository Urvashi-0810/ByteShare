<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/ByteShareCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="0dp"
    android:layout_marginBottom="12dp">

    <TextView
        android:id="@+id/crew_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:text="🍕"
        android:textSize="28sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"
        android:layout_toEndOf="@id/crew_emoji"
        android:orientation="vertical">

        <TextView
            android:id="@+id/crew_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="Crew Name"
            android:textColor="@color/primary_ink"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/crew_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4 members • ₹2,000"
            android:textColor="@color/gray_ink"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OWE"
            android:textColor="@color/gray_ink"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/crew_owe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="₹600"
            android:textColor="@color/primary_ink"
            android:textSize="18sp" />
    </LinearLayout>
</RelativeLayout>