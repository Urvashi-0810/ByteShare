<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/me_title"
                    style="@style/ByteShareTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="You" />

                <ImageView
                    android:id="@+id/btn_sign_out"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/button_chunky"
                    android:backgroundTint="@color/white"
                    android:contentDescription="Sign out"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_lock_power_off"
                    app:tint="@color/primary_ink" />
            </RelativeLayout>

            <TextView
                android:id="@+id/txt_user_email"
                style="@style/ByteShareSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="user@example.com" />

            <!-- Usage access pitch (hidden once granted) -->
            <LinearLayout
                android:id="@+id/usage_permission_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card_chunky"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="USAGE ACCESS NEEDED"
                    android:textColor="@color/primary_ink"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Grant Usage Access so ByteShare can show your screen time here."
                    android:textColor="@color/gray_ink"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn_grant_usage_me"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/button_chunky"
                    android:backgroundTint="@null"
                    android:paddingVertical="12dp"
                    android:text="Grant Access"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_ink"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Upgrade to Pro Card -->
            <RelativeLayout
                android:id="@+id/card_upgrade_pro"
                style="@style/ByteShareCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="0dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/button_chunky"
                android:backgroundTint="@color/accent_lime"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="ByteShare Pro 👑"
                        android:textColor="@color/primary_ink"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Remove Ads &amp; Unlock VIP Perks"
                        android:textColor="@color/primary_ink"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/button_chunky"
                    android:backgroundTint="@color/primary_ink"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="UPGRADE"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <LinearLayout
                style="@style/ByteShareCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="0dp"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/button_chunky"
                    android:backgroundTint="@color/accent_lime">

                    <TextView
                        android:id="@+id/txt_avatar_initial"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="sans-serif-black"
                        tools:text="?"
                        android:textColor="@color/primary_ink"
                        android:textSize="36sp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/txt_user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="sans-serif-black"
                    tools:text="You"
                    android:textColor="@color/primary_ink"
                    android:textSize="24sp" />

                <!-- XP & Streak Badges Row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/badge_user_streak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/button_chunky"
                        android:backgroundTint="#FF8A65"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        tools:text="🔥 5 Day Streak"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/badge_user_xp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/button_chunky"
                        android:backgroundTint="@color/accent_lime"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        tools:text="⭐️ 450 XP (Level 3)"
                        android:textColor="@color/primary_ink"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Earn XP via Rewarded Ad Button -->
                <Button
                    android:id="@+id/btn_earn_xp_ad"
                    style="@style/ByteShareButton"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/button_chunky_ink"
                    android:backgroundTint="@null"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="🎬 Watch Video Ad for +20 Social XP ⭐️"
                    android:textColor="@color/accent_lime"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_crew_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/gray_ink"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/button_primary"
                    android:backgroundTint="@color/primary_ink"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="8dp"
                    android:text="YOU OWE THIS WEEK"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_total_owed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-black"
                    tools:text="₹0"
                    android:textColor="@color/primary_ink"
                    android:textSize="32sp" />
            </LinearLayout>

            <!-- Your Screen Time Section -->
            <LinearLayout
                style="@style/ByteShareCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="0dp"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Your screen time · last 7 days"
                    android:textColor="@color/primary_ink"
                    android:textSize="20sp" />

                <!-- Multi-segment Progress Bar Container -->
                <LinearLayout
                    android:id="@+id/usage_progress_container"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/button_chunky"
                    android:backgroundTint="#EEEEEE"
                    android:orientation="horizontal"
                    android:clipChildren="true"
                    android:clipToPadding="true">

                    <View
                        android:id="@+id/progress_social"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0"
                        android:background="@color/cat_social" />
                    <View
                        android:id="@+id/progress_stream"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0"
                        android:background="@color/cat_stream" />
                    <View
                        android:id="@+id/progress_neutral"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0"
                        android:background="@color/cat_neutral" />
                    <View
                        android:id="@+id/progress_productive"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0"
                        android:background="@color/cat_productive" />
                </LinearLayout>

                <!-- Category Grid -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:alignmentMode="alignMargins"
                    android:columnCount="2"
                    android:useDefaultMargins="true">

                    <!-- Social Media -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:background="@drawable/card_chunky"
                        android:backgroundTint="@color/bg_cream"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/button_chunky"
                                android:backgroundTint="@color/cat_social" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="SOCIAL MEDIA"
                                android:textColor="@color/gray_ink"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txt_social_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-black"
                            tools:text="0h 0m"
                            android:textColor="@color/primary_ink"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Streaming -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:background="@drawable/card_chunky"
                        android:backgroundTint="@color/bg_cream"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/button_chunky"
                                android:backgroundTint="@color/cat_stream" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="STREAMING"
                                android:textColor="@color/gray_ink"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txt_stream_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-black"
                            tools:text="0h 0m"
                            android:textColor="@color/primary_ink"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Neutral -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:background="@drawable/card_chunky"
                        android:backgroundTint="@color/bg_cream"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/button_chunky"
                                android:backgroundTint="@color/cat_neutral" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="NEUTRAL"
                                android:textColor="@color/gray_ink"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txt_neutral_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-black"
                            tools:text="0h 0m"
                            android:textColor="@color/primary_ink"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Productivity -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:background="@drawable/card_chunky"
                        android:backgroundTint="@color/bg_cream"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/button_chunky"
                                android:backgroundTint="@color/cat_productive" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="PRODUCTIVITY"
                                android:textColor="@color/gray_ink"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txt_productive_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-black"
                            tools:text="0h 0m"
                            android:textColor="@color/primary_ink"
                            android:textSize="14sp" />
                    </LinearLayout>
                </GridLayout>

                <!-- Per-app list bifurcation -->
                <LinearLayout
                    android:id="@+id/app_list_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical" />

            </LinearLayout>


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>