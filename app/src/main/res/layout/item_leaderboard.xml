<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/ByteShareCard"
    android:id="@+id/card_friend_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="0dp"
    android:layout_marginBottom="12dp"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/avatar_container"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/button_chunky"
            android:backgroundTint="@color/accent_lime">

            <TextView
                android:id="@+id/txt_rank_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-black"
                tools:text="1"
                android:textColor="@color/primary_ink"
                android:textSize="22sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_friend_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-bold"
                android:maxLines="1"
                tools:text="Friend name"
                android:textColor="@color/primary_ink"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/txt_friend_today_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                tools:text="5h 12m last 7 days"
                android:textColor="@color/gray_ink"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_friend_rank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="RANK 1"
                android:textColor="@color/rank_1"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_friend_weighted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                tools:text="412m"
                android:textColor="@color/primary_ink"
                android:textSize="19sp" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btn_nudge_friend"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:background="@drawable/button_chunky_ink"
        android:minHeight="0dp"
        android:paddingHorizontal="14dp"
        android:text="SEND NUDGE"
        android:textAllCaps="false"
        android:textColor="@color/accent_lime"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>