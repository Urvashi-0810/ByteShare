<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/ByteShareCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="0dp"
    android:layout_marginBottom="12dp"
    android:padding="16dp">

    <!-- Emoji Frame -->
    <FrameLayout
        android:id="@+id/emoji_frame"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:background="@drawable/button_chunky"
        android:backgroundTint="@color/white">

        <TextView
            android:id="@+id/txt_challenge_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🧘"
            android:textSize="24sp" />
    </FrameLayout>

    <!-- Right Arrow Action Button -->
    <FrameLayout
        android:id="@+id/btn_arrow_frame"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:background="@drawable/button_chunky"
        android:backgroundTint="@color/white">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-black"
            android:text="→"
            android:textColor="@color/primary_ink"
            android:textSize="18sp" />
    </FrameLayout>

    <!-- Center Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_toEndOf="@id/emoji_frame"
        android:layout_toStartOf="@id/btn_arrow_frame"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_challenge_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:maxLines="1"
            android:text="Screen Sabbath redemption"
            android:textColor="@color/primary_ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txt_challenge_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Pledge a 4-hour phone-free..."
            android:textColor="@color/gray_ink"
            android:textSize="12sp" />

        <!-- Badges Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/badge_reward"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/button_chunky"
                android:backgroundTint="#EBFBCC"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="-0.2 MULTIPLIER"
                android:textColor="#2B6B00"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_pod_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="👥 4 pod"
                android:textColor="@color/gray_ink"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>