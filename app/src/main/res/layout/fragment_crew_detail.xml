<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Top Bar -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/btn_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/button_chunky"
                    android:backgroundTint="@color/white"
                    android:padding="10dp"
                    android:src="@android:drawable/ic_menu_revert"
                    app:tint="@color/primary_ink" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="16dp"
                    android:layout_toEndOf="@id/btn_back"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txt_detail_emoji"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🍕"
                            android:textSize="22sp" />

                        <TextView
                            android:id="@+id/txt_detail_name"
                            style="@style/ByteShareTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Sda"
                            android:textSize="26sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txt_detail_subtitle"
                        style="@style/ByteShareSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4 members · code A56KT4"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btn_share"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/button_chunky"
                    android:backgroundTint="@color/accent_lime"
                    android:padding="10dp"
                    android:src="@android:drawable/ic_menu_share"
                    app:tint="@color/primary_ink" />
            </RelativeLayout>

            <!-- THIS WEEK'S BILL CARD -->
            <LinearLayout
                style="@style/ByteShareCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="0dp"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:padding="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="THIS WEEK'S BILL"
                        android:textColor="@color/gray_ink"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:fontFamily="sans-serif-medium"
                        android:text="equal split: ✎"
                        android:textColor="@color/gray_ink"
                        android:textSize="12sp" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/txt_detail_total_bill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-black"
                    android:text="₹2,000"
                    android:textColor="@color/primary_ink"
                    android:textSize="36sp" />

                <!-- 3 Stats pills -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <!-- MEMBERS -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/card_chunky"
                        android:backgroundTint="@color/bg_cream"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MEMBERS"
                            android:textColor="@color/gray_ink"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_stat_members"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="4"
                            android:textColor="@color/primary_ink"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <!-- COVERED -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/card_chunky"
                        android:backgroundTint="@color/bg_cream"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="COVERED"
                            android:textColor="@color/gray_ink"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_stat_covered"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="₹2,000"
                            android:textColor="@color/primary_ink"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <!-- SPREAD -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/card_chunky"
                        android:backgroundTint="@color/bg_cream"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SPREAD"
                            android:textColor="@color/gray_ink"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_stat_spread"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="₹500"
                            android:textColor="@color/primary_ink"
                            android:textSize="16sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- INVITE CARD -->
            <RelativeLayout
                style="@style/ByteShareCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="0dp"
                android:layout_marginTop="16dp"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/btn_send_invite"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:text="Invite via Email / Message"
                        android:textColor="@color/primary_ink"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/txt_invite_url"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="http://byteshare.app/join/A56KT4"
                        android:textColor="@color/gray_ink"
                        android:textSize="11sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_send_invite"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/button_chunky"
                    android:backgroundTint="@color/primary_ink"
                    android:paddingHorizontal="16dp"
                    android:text="SEND"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- BILL SPLIT SECTION -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="BILL SPLIT"
                    android:textColor="@color/primary_ink"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="sans-serif-bold"
                    android:text="RECALCULATES LIVE"
                    android:textColor="@color/gray_ink"
                    android:textSize="10sp" />
            </RelativeLayout>

            <!-- BILL SPLIT TABLE CARD -->
            <LinearLayout
                style="@style/ByteShareCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="0dp"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:padding="0dp">

                <!-- Table Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-black"
                        android:text="MEMBER"
                        android:textColor="@color/gray_ink"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:fontFamily="sans-serif-black"
                        android:text="×"
                        android:textColor="@color/gray_ink"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:fontFamily="sans-serif-black"
                        android:text="PAYS"
                        android:textColor="@color/gray_ink"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E5E5EA" />

                <!-- Dynamic Member Rows Container -->
                <LinearLayout
                    android:id="@+id/member_rows_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/primary_ink" />

                <!-- Total Row -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="TOTAL"
                        android:textColor="@color/primary_ink"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/txt_split_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:fontFamily="sans-serif-black"
                        android:text="₹2,000"
                        android:textColor="@color/primary_ink"
                        android:textSize="22sp" />
                </RelativeLayout>
            </LinearLayout>

            <!-- WHY YOU PAY SECTION -->
            <LinearLayout
                style="@style/ByteShareCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="0dp"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/button_chunky"
                        android:backgroundTint="@color/white">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="sans-serif-black"
                            android:text="ⓘ"
                            android:textColor="@color/primary_ink"
                            android:textSize="20sp" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txt_why_you_pay_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="Why you pay ₹600"
                            android:textColor="@color/primary_ink"
                            android:textSize="20sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="TRANSPARENT CALCULATION FORMULA"
                            android:textColor="@color/gray_ink"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Category Breakdown Rows -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical">

                    <!-- Social Media -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/lbl_social"
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="SOCIAL\nMEDIA"
                            android:textColor="@color/gray_ink"
                            android:textSize="11sp" />

                        <View
                            android:layout_width="100dp"
                            android:layout_height="8dp"
                            android:layout_centerVertical="true"
                            android:layout_toEndOf="@id/lbl_social"
                            android:background="@drawable/button_chunky"
                            android:backgroundTint="@color/cat_social" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txt_social_hours"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="4.3h"
                                android:textColor="@color/primary_ink"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="×2.0"
                                android:textColor="@color/gray_ink"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </RelativeLayout>

                    <!-- Streaming -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/lbl_stream"
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="STREAMING"
                            android:textColor="@color/gray_ink"
                            android:textSize="11sp" />

                        <View
                            android:layout_width="70dp"
                            android:layout_height="8dp"
                            android:layout_centerVertical="true"
                            android:layout_toEndOf="@id/lbl_stream"
                            android:background="@drawable/button_chunky"
                            android:backgroundTint="@color/cat_stream" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txt_stream_hours"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="2.8h"
                                android:textColor="@color/primary_ink"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="×1.5"
                                android:textColor="@color/gray_ink"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </RelativeLayout>

                    <!-- Neutral -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/lbl_neutral"
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="NEUTRAL"
                            android:textColor="@color/gray_ink"
                            android:textSize="11sp" />

                        <View
                            android:layout_width="40dp"
                            android:layout_height="8dp"
                            android:layout_centerVertical="true"
                            android:layout_toEndOf="@id/lbl_neutral"
                            android:background="@drawable/button_chunky"
                            android:backgroundTint="@color/cat_neutral" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txt_neutral_hours"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="1.5h"
                                android:textColor="@color/primary_ink"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="×1.0"
                                android:textColor="@color/gray_ink"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </RelativeLayout>

                    <!-- Productivity -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/lbl_productive"
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="PRODUCTIVITY"
                            android:textColor="@color/gray_ink"
                            android:textSize="11sp" />

                        <View
                            android:layout_width="35dp"
                            android:layout_height="8dp"
                            android:layout_centerVertical="true"
                            android:layout_toEndOf="@id/lbl_productive"
                            android:background="@drawable/button_chunky"
                            android:backgroundTint="@color/cat_productive" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:gravity="end"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txt_productive_hours"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-black"
                                android:text="1.3h"
                                android:textColor="@color/primary_ink"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="×0.5"
                                android:textColor="@color/gray_ink"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </RelativeLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="16dp"
                    android:background="#E5E5EA" />

                <!-- Bottom 3 Pill Badges -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- RAW TIME -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="70dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/card_chunky"
                        android:backgroundTint="@color/bg_cream"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RAW TIME"
                            android:textColor="@color/gray_ink"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_raw_time_sum"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="9.8h"
                            android:textColor="@color/primary_ink"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <!-- WEIGHTED -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="70dp"
                        android:layout_marginHorizontal="3dp"
                        android:layout_weight="1"
                        android:background="@drawable/card_chunky"
                        android:backgroundTint="@color/bg_cream"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WEIGHTED"
                            android:textColor="@color/gray_ink"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_weighted_sum"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="889.5"
                            android:textColor="@color/primary_ink"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <!-- MULT. (LIME) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="70dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_chunky"
                        android:backgroundTint="@color/accent_lime"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MULT."
                            android:textColor="@color/primary_ink"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txt_mult_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="×1.20"
                            android:textColor="@color/primary_ink"
                            android:textSize="18sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>